{
    "name": "Shortcuts",
    "version": "2.0.0",
    "author": [
        "Vitaliy Filippov",
        "AI Update"
    ],
    "descriptionmsg": "shortcuts-desc",
    "url": "[https://wiki.4intra.net/Shortcuts](https://wiki.4intra.net/Shortcuts)",
    "license-name": "GPL-2.0-or-later",
    "type": "other",
    "requires": {
        "MediaWiki": ">= 1.39.0"
    },
    "MessagesDirs": {
        "Shortcuts": [
            "i18n"
        ]
    },
    "AutoloadNamespaces": {
        "MediaWiki\\Extension\\Shortcuts\\": "includes/"
    },
    "ResourceModules": {
        "ext.Shortcuts": {
            "styles": {
                "shortcuts.css": { "media": "screen" },
                "shortcuts.print.css": { "media": "print" }
            },
            "localBasePath": "resources",
            "remoteExtPath": "Shortcuts/resources"
        }
    },
    "Hooks": {
        "ArticleViewHeader": "MediaWiki\\Extension\\Shortcuts\\Hooks::onArticleViewHeader"
    },
    "manifest_version": 2
}